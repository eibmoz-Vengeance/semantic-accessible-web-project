# ==================================================
# PERSONAL NOTES AND PRIVATE WORKING MATERIAL
# ==================================================

# Exclude the entire personal-notes directory.
/personal-notes/

# Exclude local notes and drafts.
*.notes
*.note
*.draft
*.bak
*.backup
*.tmp
*.temp

# Exclude editor swap and recovery files.
*.swp
*.swo
*~

# ==================================================
# WINDOWS AND OPERATING SYSTEM METADATA
# ==================================================

# Windows File Explorer metadata.
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini

# macOS metadata, if files are ever transferred.
.DS_Store
.AppleDouble
.LSOverride

# ==================================================
# VISUAL STUDIO AND VISUAL STUDIO CODE
# ==================================================

# Visual Studio workspace and cache files.
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates

# Visual Studio Code workspace settings.
.vscode/

# ==================================================
# GIT AND TEMPORARY FILES
# ==================================================

# Git patch files and temporary merge artifacts.
*.orig
*.rej

# ==================================================
# BUILD OUTPUT AND DEPENDENCIES
# ==================================================

# Common build output.
bin/
obj/
dist/
build/

# Node.js dependencies and debug logs.
node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ==================================================
# LOCAL ENVIRONMENT AND CREDENTIALS
# ==================================================

# Environment variable files.
.env
.env.*
!.env.example

# Private keys and certificate files.
*.pem
*.key
*.p12
*.pfx

# Local machine-specific configuration.
*.local